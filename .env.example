# Copia este archivo a .env y completa los valores. .env NUNCA se versiona.

# Clave de la API de Anthropic. Sin clave, el agente corre en modo simulado (--simulado).
ANTHROPIC_API_KEY=

# Azure DevOps (fase F7). Usa solo una organización de prueba con HU sintéticas.
# Ejemplo de URL: https://dev.azure.com/<organizacion>
AZDO_ORG_URL=
AZDO_PROJECT=
# PAT con alcance mínimo: Work Items (Read & write). Se enmascara en trazas y logs.
AZDO_PAT=
